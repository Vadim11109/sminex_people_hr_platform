# ═══════════════════════════════════════════════════════════════════════════
# Sminex People — environment variables
# Copy to .env.local (dev) or provide via your secret store (prod).
# NEVER commit real values. This file lists names only.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Connection string to the Postgres instance in your perimeter.
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# Add ?sslmode=require (or ?sslmode=verify-full) if the DB enforces TLS.
DATABASE_URL=

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Public base URL of the deployed app (used for OAuth callbacks & cookies).
# e.g. https://people.sminex.corp
NEXTAUTH_URL=
# Random secret for signing sessions/JWT. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── Microsoft Entra ID (Azure AD) ───────────────────────────────────────────
# From the app registration in YOUR Entra tenant.
# Redirect URI to register: {NEXTAUTH_URL}/api/auth/callback/microsoft-entra-id
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
# Set false when migrations are run by a separate init-container/Job (recommended
# for multi-replica). Default true = the app applies migrations on startup.
# RUN_MIGRATIONS=true
